{
  "name": "claude-whatsapp-agent",
  "version": "1.0.0",
  "description": "Autonomous WhatsApp AI Assistant powered by Gemini, the official WhatsApp Cloud API, WhatsApp Flows, calendar booking and human escalation",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "DATA_DIR=$(mktemp -d) GEMINI_API_KEY= SIMULATION_MODE=true tsx test/runAllTests.ts"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
