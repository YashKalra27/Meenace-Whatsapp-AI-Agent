# Server Configuration
PORT=3000
NODE_ENV=development

# Meta WhatsApp Cloud API Credentials
# Obtained from Meta App Dashboard (developers.facebook.com) -> WhatsApp -> API Setup
WHATSAPP_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=choose_a_long_random_phrase
# Optional: must match the app secret exactly, or every inbound message is dropped
WHATSAPP_APP_SECRET=

# Google Gemini API Configuration
# Obtained from aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Admin API (/api/*) bearer token; the admin API is disabled when empty
ADMIN_TOKEN=

# Owner: Meenace answers only this WhatsApp number (digits, country code first)
OWNER_PHONE=
OWNER_NAME=Yash

# Kalvion backend (public HTTPS URL) and its KALVION_API_TOKEN
KALVION_URL=
KALVION_API_TOKEN=

# Simulation: log outbound messages instead of sending them (set false in production)
SIMULATION_MODE=true
