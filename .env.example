# Server Configuration
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Meta WhatsApp Cloud API Credentials
# Obtained from Meta App Dashboard (developers.facebook.com) -> WhatsApp -> API Setup
WHATSAPP_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id_here
WHATSAPP_VERIFY_TOKEN=claude_whatsapp_secret_verify_token_2026
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# Anthropic Claude API Configuration
# Obtained from console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Human Escalation Notification Destination
ESCALATION_EMAIL=founder@example.com
ESCALATION_PHONE=+1234567890

# Sandbox / Simulation Mode (set true to simulate Meta WhatsApp Cloud API locally without requiring paid Meta credentials)
SIMULATION_MODE=true
